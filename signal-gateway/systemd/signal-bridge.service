[Unit]
Description=signal-cli directory bridge for RTC test contacts
After=network-online.target signal-cli.service
Wants=network-online.target

[Service]
Type=simple
User=signal-gateway
Group=signal-gateway
WorkingDirectory=/opt/signal-gateway
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/signal-gateway.env
ExecStart=/opt/signal-gateway/.venv/bin/python /opt/signal-gateway/signal_bridge.py --rpc http://127.0.0.1:7583/api/v1/rpc
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
